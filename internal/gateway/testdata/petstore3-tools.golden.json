  {
    "description": "POST /pet\nAdd a new pet to the store.\nAdd a new pet to the store.",
    "inputSchema": {
      "properties": {
        "requestBody": {
          "properties": {
            "category": {
              "properties": {
                "id": {
                  "example": 1,
